{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigestsToSemver",
    "docker:pinDigests",
    ":configMigration",
    ":docker",
    ":separateMajorReleases",
    ":separateMultipleMinorReleases",
    ":separatePatchReleases"
  ],
  "baseBranchPatterns": ["main", "/^cryostat-v.*/"],
  "reviewersFromCodeOwners": true,
  "labels": [
    "dependencies",
    "chore",
    "safe-to-test"
  ],
  "semanticCommits": "enabled",
  "major": {
    "dependencyDashboardApproval": true
  },
  "stopUpdatingLabel": "blocked",
  "packageRules": [
    {
      "description": "Dockerfile base image updates are never gated by the dependency dashboard, on any branch",
      "matchManagers": ["dockerfile"],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Disable all dependency updates on release branches except Dockerfile base images; other updates there are handled via Mergify backport",
      "matchBaseBranches": ["/^cryostat-v.*/"],
      "enabled": false
    },
    {
      "description": "Allow Dockerfile base image updates on release branches",
      "matchBaseBranches": ["/^cryostat-v.*/"],
      "matchManagers": ["dockerfile"],
      "enabled": true
    },
    {
      "description": "Require approval for projectnessie updates",
      "matchManagers": [
        "maven"
      ],
      "dependencyDashboardApproval": true,
      "matchPackageNames": [
        "/^org\\.projectnessie\\.cel:/"
      ]
    },
    {
      "description": "Require approval for protobuf updates",
      "matchManagers": [
        "maven"
      ],
      "dependencyDashboardApproval": true,
      "matchPackageNames": [
        "/^com\\.google\\.protobuf:/"
      ]
    },
    {
      "description": "Require approval for dagger updates",
      "matchManagers": [
        "maven"
      ],
      "dependencyDashboardApproval": true,
      "matchPackageNames": [
        "/^com\\.google\\.dagger:/"
      ]
    }
  ]
}

